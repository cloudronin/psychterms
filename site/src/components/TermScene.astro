---
import {sceneState, RISK_NOTICE} from '../scene-state.mjs';
const {entry}=Astro.props;
const state=sceneState(entry);
---
{state==='risk' && <p class="risk-scene-notice">{RISK_NOTICE}</p>}
{state==='scene' && <section class="term-scene" aria-labelledby="scene-heading">
  <h2 id="scene-heading">The term in a room</h2>
  <p>{entry.vignette.text}</p>
  <p class="scene-notice">{entry.vignette.notice}</p>
</section>}
