{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PsychTerms entry",
  "type": "object",
  "required": [
    "id",
    "term",
    "definition",
    "also_see",
    "field",
    "aliases",
    "sources",
    "provenance",
    "version",
    "hash"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "term": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "also_see": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "field": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "source",
          "revision",
          "scope"
        ],
        "properties": {
          "role": {
            "enum": [
              "draft_basis",
              "supports_definition",
              "related_topic"
            ]
          },
          "source": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "exam_layer_id": {
      "type": "string"
    },
    "packet_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviews": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "model",
          "passed",
          "entry_hash",
          "packet_hash",
          "receipt_id",
          "rubric_hash"
        ]
      }
    },
    "risk": {
      "const": true,
      "description": "Build-owned flag derived from the pinned risk_terms.json, never hand edited."
    },
    "model_review": {
      "type": "object",
      "required": [
        "model",
        "passed",
        "definition_hash",
        "packet_hash",
        "published_packet_hash",
        "receipt_id",
        "request_hash",
        "draft_model",
        "registration_hash"
      ],
      "properties": {
        "passed": {
          "const": true
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "definition_hash": {
          "type": "string",
          "minLength": 1
        },
        "packet_hash": {
          "type": "string",
          "minLength": 1
        },
        "published_packet_hash": {
          "type": "string",
          "minLength": 1
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "request_hash": {
          "type": "string",
          "minLength": 1
        },
        "draft_model": {
          "type": "string",
          "minLength": 1
        },
        "registration_hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "editorial_status": {
      "enum": [
        "wording_review_pending",
        "human_review_pending"
      ]
    },
    "editorial_note": {
      "type": "string"
    },
    "draft_evidence": {
      "type": "object",
      "required": [
        "model",
        "receipt_id",
        "request_hash",
        "registration_hash",
        "definition_hash",
        "packet_hash"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "request_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "registration_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "definition_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "packet_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "fixture": {
      "const": true
    },
    "status": {
      "enum": [
        "candidate",
        "reviewed",
        "judged",
        "dropped",
        "redraft"
      ],
      "description": "Build-owned and forward only per entry, not per headword; forbidden in source files."
    },
    "checks": {
      "type": "object",
      "required": [
        "readers",
        "copy"
      ],
      "properties": {
        "readers": {
          "enum": [
            "0/2",
            "1/2",
            "2/2"
          ]
        },
        "copy": {
          "enum": [
            "clear",
            "hit"
          ]
        }
      },
      "additionalProperties": false
    },
    "released": {
      "type": "boolean",
      "description": "Build-owned numbered-release inclusion, not a review status."
    },
    "release_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "drafter": {
      "type": "string"
    },
    "drop_reason": {
      "type": "string",
      "minLength": 1
    },
    "reader_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model",
          "passed",
          "definition_hash",
          "packet_hash",
          "receipt_id",
          "request_hash",
          "draft_model",
          "registration_hash"
        ],
        "properties": {
          "passed": {
            "type": "boolean"
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "definition_hash": {
            "type": "string",
            "minLength": 1
          },
          "packet_hash": {
            "type": "string",
            "minLength": 1
          },
          "published_packet_hash": {
            "type": "string",
            "minLength": 1
          },
          "receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "request_hash": {
            "type": "string",
            "minLength": 1
          },
          "draft_model": {
            "type": "string",
            "minLength": 1
          },
          "registration_hash": {
            "type": "string",
            "minLength": 1
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "external_review": {
      "type": "object",
      "required": [
        "batch",
        "manifest_sha256"
      ],
      "properties": {
        "batch": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "new_packet_required": {
      "const": true
    },
    "scope_review": {
      "const": "pending"
    },
    "redraft_of": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "additionalProperties": false
}
